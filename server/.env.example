# Copy to .env (or pass as -e flags to docker run). All values optional except
# you SHOULD set a stable SHARDX_TOKEN_SECRET in production.

# Bind address. Defaults to 127.0.0.1:8080 (loopback only) when unset. Set
# 0.0.0.0 to expose it (behind a reverse proxy) — but see SHARDX_ADMIN_PASS:
# a network-facing bind refuses to start with a weak/default admin password.
SHARDX_BIND=0.0.0.0:8080

# Where the SQLite DB and snapshot blobs live (a Docker volume in production).
SHARDX_DATA_DIR=./data

# HS256 signing secret for auth tokens. If unset, a random one is generated at
# startup and ALL tokens become invalid on every restart — set a long, random,
# stable value in production.
SHARDX_TOKEN_SECRET=change-me-to-a-long-random-string

# Token lifetime in seconds (default 7 days).
SHARDX_TOKEN_TTL_SECS=604800

# Bootstrap admin, created only when the user table is empty (first run). On a
# non-loopback bind this must be a STRONG secret (>=8 chars, not a placeholder
# like admin/secret/change-me) or the server refuses to start. Set your own:
SHARDX_ADMIN_USER=admin
SHARDX_ADMIN_PASS=

# Login-throttle client-IP source. Default 0: use the real peer socket
# (unspoofable). Set 1 ONLY behind a reverse proxy that OVERWRITES the inbound
# X-Forwarded-For / X-Real-IP header (and blocks direct access) — otherwise a
# client could spoof the header to dodge the per-IP rate limit.
SHARDX_TRUST_PROXY=0
