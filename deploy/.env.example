# Copy to `.env` in this directory and fill in. docker compose reads `.env`
# automatically for variable substitution. Keep the real `.env` out of git.

# Public domain that resolves (A/AAAA) to this host. Caddy obtains an HTTPS
# certificate for it automatically, and the launcher connects to
# https://<this domain>.
SHARDX_DOMAIN=team.example.com

# HS256 token signing secret. MUST be long, random, and STABLE across restarts
# — if it changes, every issued token is invalidated (all users logged out).
# Generate once and keep it:  openssl rand -hex 32
SHARDX_TOKEN_SECRET=

# Bootstrap admin, created only on first start when the user table is empty.
# The server is network-facing, so this MUST be a strong secret (>=8 chars, not
# a placeholder like admin/secret/change-me) or the server refuses to start.
# Generate one:  openssl rand -base64 18
SHARDX_ADMIN_USER=admin
SHARDX_ADMIN_PASS=
